{
  "name": "private-health-certificates",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:provision-owner": "tsx scripts/provision-owner.mts",
    "pdf:smoke": "node --conditions=import --import tsx scripts/pdf-smoke.mts",
    "pdf2:smoke": "node --conditions=import --import tsx scripts/pdf2-smoke.mts",
    "status:smoke": "node --conditions=import --import tsx scripts/certificate-status-smoke.mts",
    "validation:smoke": "node --conditions=import --import tsx scripts/certificate-validation-smoke.mts"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@aws-sdk/client-s3": "^3.1176.0",
    "@neondatabase/serverless": "^1.2.1",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-pdf/renderer": "^4.9.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "next-auth": "^4.24.15",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.9",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "@react-pdf/hyphenate": "0.1.0",
    "effect": "3.22.5"
  }
}
