generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
  EDITOR
  VIEWER
}

enum CertificateStatus {
  VALID
  EXPIRED
  REVOKED
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(ADMIN)
  isActive      Boolean   @default(true)
  organizationId String   @db.Uuid
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  auditLogs     AuditLog[]
  certificatesCreated Certificate[] @relation("CertificateCreator")
  versionsChanged CertificateVersion[] @relation("VersionEditor")
  @@index([organizationId, role])
}

model Organization {
  id           String @id @default(uuid()) @db.Uuid
  name         String
  nameAr       String
  number       String @unique
  users        User[]
  certificates Certificate[]
  settings     OrganizationSettings?
  auditLogs    AuditLog[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Certificate {
  id                    String @id @default(uuid()) @db.Uuid
  organizationId        String @db.Uuid
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  certificateNumber     String?
  verificationTokenHash String @unique
  verificationTokenCiphertext String
  status                CertificateStatus @default(VALID)
  fullName              String?
  fullNameAr            String?
  identityNumber        String?
  gender                String?
  nationality           String?
  nationalityAr         String?
  profession            String?
  professionAr          String?
  photoKey              String?
  issueDate             DateTime?
  expiryDate            DateTime?
  hijriIssueDate        String?
  hijriExpiryDate       String?
  organizationName      String?
  organizationNameAr    String?
  organizationNumber    String?
  licenseNumber         String?
  municipality          String?
  city                  String?
  programType           String?
  programExpiryDate     DateTime?
  revokedAt             DateTime?
  revokeReason          String?
  createdById           String @db.Uuid
  createdBy             User @relation("CertificateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions              CertificateVersion[]
  auditLogs             AuditLog[]
  verificationLogs      VerificationLog[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@index([organizationId, status, expiryDate])
  @@index([organizationId, fullName])
  @@unique([organizationId, certificateNumber])
}

model CertificateVersion {
  id            String @id @default(uuid()) @db.Uuid
  certificateId String @db.Uuid
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  version       Int
  snapshot      Json
  changedById   String @db.Uuid
  changedBy     User @relation("VersionEditor", fields: [changedById], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())
  @@unique([certificateId, version])
  @@index([certificateId, createdAt])
}

model AuditLog {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorId        String @db.Uuid
  actor          User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  certificateId  String? @db.Uuid
  certificate    Certificate? @relation(fields: [certificateId], references: [id], onDelete: SetNull)
  action         String
  metadata       Json?
  createdAt      DateTime @default(now())
  @@index([organizationId, createdAt])
  @@index([certificateId, createdAt])
}

model VerificationLog {
  id            String @id @default(uuid()) @db.Uuid
  certificateId String? @db.Uuid
  certificate   Certificate? @relation(fields: [certificateId], references: [id], onDelete: SetNull)
  tokenHash     String?
  outcome       String
  ipHash        String?
  createdAt     DateTime @default(now())
  @@index([certificateId, createdAt])
  @@index([createdAt])
}

model PublicRateLimit {
  key       String @id
  window    DateTime @db.Timestamp(0)
  hits      Int @default(0)
  @@index([window])
}

model OrganizationSettings {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logoKey        String?
  brandColor     String @default("#16805b")
  certificatePrefix String @default("HC")
  updatedAt      DateTime @updatedAt
}
